            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "tenant_id",
          "user_id",
          "task_type",
          "status",
          "symbol",
          "mode",
          "as_of",
          "requested_modules",
          "question",
          "created_at",
          "updated_at"
