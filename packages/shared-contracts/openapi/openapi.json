            "type": "string",
            "format": "uuid",
            "title": "Tenant Id"
          },
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id"
          },
          "task_type": {
            "type": "string",
            "title": "Task Type"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "mode": {
            "type": "string",
            "title": "Mode"
          },
          "as_of": {
            "anyOf": [
              {
                "type": "string",
