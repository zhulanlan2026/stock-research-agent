# Production secrets for docker-compose.prod.yml.
# Copy to `.env` on the deploy host and fill in real values.
# Values must not contain '$'; prefer URL-safe alphanumerics or base64url.

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=research_db

REDIS_PASSWORD=

MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Must be a random value of at least 32 characters, distinct from development.
JWT_SECRET_KEY=

# Ingest token used by the XTQuant collector; random value of at least 32 characters.
COLLECTOR_INGEST_TOKEN=
