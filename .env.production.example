# Production secrets for docker-compose.prod.yml.
# Copy to `.env` on the deploy host and fill in real values.
# Values must not contain '$'; prefer URL-safe alphanumerics or base64url.

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=research_db

REDIS_PASSWORD=

MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Must be a random value of at least 32 characters, distinct from development.
JWT_SECRET_KEY=

# Ingest token used by the XTQuant collector; random value of at least 32 characters.
COLLECTOR_INGEST_TOKEN=

# Optional DeepSeek/OpenAI-compatible model gateway.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Optional PyTorch LSTM cycle predictor. Build backend image with
# `--build-arg INSTALL_TORCH=true` before enabling this flag.
TECHNICAL_CYCLE_HORIZON=5
TECHNICAL_LSTM_ENABLED=false
TECHNICAL_LSTM_SEED=0
TECHNICAL_LSTM_HIDDEN_SIZE=8
TECHNICAL_LSTM_EPOCHS=50
TECHNICAL_LSTM_WINDOW=20
