APP_ENV=development
APP_NAME=stock-research-platform
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://research:research123@localhost:5432/research_db
REDIS_URL=redis://:redis123@localhost:6379/0

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false

# 采集器推送 Ingest API 时使用的令牌；生产环境必须注入随机值且长度 >= 32。
COLLECTOR_INGEST_TOKEN=

MILVUS_URI=http://localhost:19530

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
MODEL_FAST=
MODEL_RESEARCH=
MODEL_REVIEW=
MODEL_FALLBACK=
MODEL_DISCOVERY_ON_STARTUP=true
EXTERNAL_MODEL_DEFAULT_DENY=true

JWT_ISSUER=stock-research
JWT_AUDIENCE=stock-research-web
# 生产环境必须注入随机值且长度 >= 32；开发环境可留空使用 dev 默认值。
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
# 生产环境必须为 true；开发环境 HTTP 下保持 false。
REFRESH_COOKIE_SECURE=false

# 后端从 inbox_event 消费到正式行情存储的后台轮询间隔（秒）。
MARKET_CONSUME_INTERVAL_SECONDS=1.0

SSE_HEARTBEAT_SECONDS=15
MAX_UPLOAD_MB=100

OTEL_SERVICE_NAME=stock-research-backend
