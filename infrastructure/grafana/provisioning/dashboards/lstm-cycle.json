{
  "uid": "stock-research-lstm-cycle",
  "title": "Stock Research LSTM Cycle",
  "tags": ["stock-research", "lstm", "cycle"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries",
      "title": "LSTM Prediction Latency",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "technical_lstm_latency_ms_last",
          "legendFormat": "latency_ms",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "always"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "LSTM Invocations",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "increase(technical_lstm_invocations_total[1h])",
          "legendFormat": "1h increase",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70
          }
        },
        "overrides": []
      }
    }
  ]
}
