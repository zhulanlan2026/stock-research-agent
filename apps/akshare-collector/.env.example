# AKShare / Tushare 行情采集器环境变量示例
COLLECTOR_APP_ENV=development
COLLECTOR_BACKEND_URL=http://localhost:8000/api/v1
COLLECTOR_INGEST_TOKEN=dev-collector-token-change-me

# 需要采集的 A 股代码，逗号分隔，格式如 600519.SH,000001.SZ。
COLLECTOR_COLLECT_SYMBOLS=600519.SH,000001.SZ
# 需要采集的 K 线周期，逗号分隔：1m,5m,15m,30m,1h,1d。
COLLECTOR_COLLECT_PERIODS=1m,1d
# 日线回补的天数。
COLLECTOR_HISTORY_DAYS=730

# 行情主数据源：akshare（默认）或 tushare。tushare 仅采集历史 K 线。
COLLECTOR_MARKET_SOURCE=akshare
# Tushare 复权类型：空=不复权，qfq=前复权，hfq=后复权（仅日线有效）。
COLLECTOR_TUSHARE_ADJUST=

# 是否采集公告。AKShare 公告接口字段可能随版本变化，默认关闭。
COLLECTOR_COLLECT_NEWS_ENABLED=false

# 是否采集本地 JSON Lines 财务事实。
COLLECTOR_COLLECT_FINANCIAL_ENABLED=false
# 财务事实数据源：jsonl（本地 JSON Lines）或 tushare。
COLLECTOR_FINANCIAL_SOURCE=jsonl
COLLECTOR_FINANCIAL_DATA_PATH=./data/financial-facts.jsonl

# Tushare token。market_source=tushare 时必填；akshare 交叉验证留空则跳过。
COLLECTOR_TUSHARE_TOKEN=
COLLECTOR_CROSS_VALIDATION_ENABLED=true
COLLECTOR_CROSS_VALIDATION_TOLERANCE=0.005

COLLECTOR_QUOTE_REFRESH_SECONDS=60.0
COLLECTOR_BARS_REFRESH_SECONDS=21600.0
COLLECTOR_WAL_PATH=./data/collector-local-wal.sqlite
COLLECTOR_POLL_INTERVAL_SECONDS=1.0
COLLECTOR_LOG_LEVEL=INFO
